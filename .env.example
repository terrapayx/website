# Terra Pay X website — example environment configuration.
# Copy to `.env.local` for local development. Only NEXT_PUBLIC_* variables are
# exposed to the browser. This is a static export (next.config.js `output:
# 'export'`), so these values are inlined at BUILD time — set them before
# `npm run build`, not at runtime.

# Checkout destination for the AI Engineering System Starter Kit landing page
# (/products/ai-engineering-starter-kit). Set this to the real Terra Pay X
# payment link once it has been generated (see merchant-platform setup docs,
# identifier FRPE-001-PAYLINK). When unset, the "Get the Starter Kit" CTA falls
# back to the /contact route — it never points at a fabricated payment URL.
# Example value format (replace with the real link before launch):
#   NEXT_PUBLIC_STARTER_KIT_PAYMENT_URL="https://pay.terrapayx.com/pay/<slug>"
NEXT_PUBLIC_STARTER_KIT_PAYMENT_URL=

# Canonical observation collector endpoint (GIP-1-B). When set, the observation
# layer beacons canonical observation events (see src/observation/) to this
# FIRST-PARTY URL via navigator.sendBeacon. When unset, events are logged to the
# browser console instead — the events are identical, vendor-neutral canonical
# events either way. No third-party analytics vendor is ever contacted.
#   NEXT_PUBLIC_OBSERVATION_ENDPOINT="https://collect.terrapayx.com/o"
NEXT_PUBLIC_OBSERVATION_ENDPOINT=
